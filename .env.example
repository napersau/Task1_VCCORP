# Docker Compose / application
SERVER_PORT=8080

# PostgreSQL/MySQL when running outside Docker
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/gold_price_db
DB_USERNAME=gold_user
DB_PASSWORD=change-me
POSTGRES_DB=gold_price_db
POSTGRES_USER=gold_user
POSTGRES_PASSWORD=gold_demo_password

# Redis
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=10m

# Scheduler (disabled until a real source is configured)
GOLD_PRICE_SCHEDULER_ENABLED=false
GOLD_PRICE_SOURCE_URL=https://provider.example/api/gold-prices
GOLD_PRICE_SOURCE_API_KEY=
GOLD_PRICE_SCHEDULER_CRON=0 */5 * * * *
GOLD_PRICE_SCHEDULER_ZONE=Asia/Ho_Chi_Minh
GOLD_PRICE_SOURCE_TIMEOUT=10s

# Logging
LOG_PATH=logs
APP_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=INFO
